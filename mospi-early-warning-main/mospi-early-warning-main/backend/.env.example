# ---------------------------------------------------------------
# MoSPI Dhrishti Backend — environment configuration
# Copy this file to `.env` and fill in the values.
# ---------------------------------------------------------------

DATABASE_URL=sqlite:///mospi_ew.db
MODEL_DIR=./models
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Directory of a production React build to serve single-origin (SPA + API from
# the same port). Leave empty in dev; the FastAPI process then stays API-only.
# The default below resolves to <repo>/frontend/dist.
# FRONTEND_DIST=

# First boot: when true and the projects table is empty, train on the real
# MoSPI panel and seed the database automatically (same pipeline as
# POST /admin/seed-database?source=pdf). Keep false on dev boxes.
AUTO_SEED_DATABASE=false

# ---------------------------------------------------------------
# Google OAuth 2.0 (Sign in with Google)
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth 2.0 Client ID -> "Web application").
# ---------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must EXACTLY match the "Authorized redirect URIs" in the Google Console.
# For local dev this default keeps working; change it with the host you use.
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# Frontend origin OAuth returns to after sign-in.
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------
# Session tokens & auth behavior
# ---------------------------------------------------------------
# Use a long, random value in production (e.g. `python -c "import secrets;print(secrets.token_hex(32))"`)
JWT_SECRET=dev-secret-change-me-in-production-mospi-ew
JWT_EXPIRY_HOURS=8

# Disable the mock/demo login in production. Keep "false".
AUTH_DEMO_MODE=false

# Seed a bootstrap admin (email admin@gov.in) on first startup.
AUTH_SEED_ADMIN=true

# Google sign-in emails auto-promoted to Admin (Active) on first login.
# Comma-separated. This bootstraps the first admin — set it to YOUR gmail address.
AUTH_SUPERADMIN_EMAILS=
# MongoDB (primary project-monitoring + IDS storage)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=dhrishti
MONGO_SERVER_TIMEOUT_MS=3000

# Assistant/RAG chat (local Ollama). The docker-compose backend targets the
# `ollama` service; leave the defaults to use a locally running Ollama.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text

# Local chat request bounds, in seconds.
OLLAMA_REQUEST_TIMEOUT_SECONDS=25
OLLAMA_EMBED_TIMEOUT_SECONDS=8

# New ministry scopes are closed by default. Add one ordered ministry at a time
# and its measured evaluation report only after all gates pass.
MINISTRY_EXPANSION_ORDER=
PHASE_GATE_EVALUATIONS_JSON=

# Defensive IDS
IDS_RATE_LIMIT=300
IDS_RATE_WINDOW_SECONDS=60
IDS_BLOCK_THRESHOLD=20
IDS_BLOCK_DURATION_HOURS=24
IDS_ANOMALY_THRESHOLD=85
IDS_IFOREST_ESTIMATORS=120
IDS_IFOREST_CONTAMINATION=0.05
