{#- T6 : All Ongoing Projects (project-wise, ministry bands, red subtotals). -#}
{% from "_macros.j2" import asterisk %}
<div class="appendix-table section-gap">
  <div class="table-heading">
    <div class="th-name">TABLE 6 : ALL ONGOING PROJECTS</div>
    <div class="th-desc">Project-wise status of every ongoing central sector infrastructure project
      ({{ tables.t6 | map(attribute="count") | sum }} projects as on {{ meta.month_label }}).</div>
  </div>

  {% set ns = namespace(orig=0.0, rev=0.0, exp=0.0, count=0) %}
  {% for band in tables.t6 %}{% set ns.orig = ns.orig + band.original_cost %}{% set ns.rev = ns.rev + band.revised_cost %}{% set ns.exp = ns.exp + band.expenditure %}{% set ns.count = ns.count + band.count %}{% endfor %}

  <table>
    <thead>
      <tr>
        <th class="c" style="width:3%">Sl.</th>
        <th class="l">Project / Agency</th>
        <th class="l">State</th>
        <th class="c">Date of Approval<span class="u">Start Date</span></th>
        <th class="c">Original / Target DoC<span class="u">Revised DoC</span></th>
        <th class="r">Original Cost<span class="u">Revised Cost, ₹ crore</span></th>
        <th class="r">Cumulative Expenditure<span class="u">₹ crore</span></th>
        <th class="r">Physical %</th>
      </tr>
    </thead>
    <tbody>
      {% set sl = namespace(n=0) %}
      {% for band in tables.t6 %}
      <tr class="band-l1"><td class="l" colspan="8">{{ band.name }}</td></tr>
      {% for p in band.projects %}
      {% set sl.n = sl.n + 1 %}
      <tr>
        <td class="c">{{ sl.n }}</td>
        <td>
          <span class="code">{{ p.legacy_code or p.pmgid or "" }}</span> {{ p.project_name }}
          <div class="small agency">{{ p.agency }} &middot; {{ p.ministry }}</div>
        </td>
        <td class="l"><span>{{ p.state }}</span>
          {% if p.is_north_east %}<span class="small"> (NE)</span>{% endif %}</td>
        <td class="c">{{ p.approval_date | mm_yyyy }}<span class="small">{{ p.start_date | mm_yyyy }}</span></td>
        <td class="c">{{ p.original_doc | mm_yyyy }}<span class="small">{{ p.revised_doc | mm_yyyy }}</span></td>
        <td class="r">{{ p.original_cost | intl }}<span class="small">{{ p.revised_cost | intl }}</span></td>
        <td class="r">{{ p.cumulative_expenditure | intl }}</td>
        <td class="r">{{ "%.2f"|format(p.physical_progress_pct) }}</td>
      </tr>
      {% endfor %}
      <tr class="band-sub">
        <td class="r" colspan="5">Total : {{ band.name }}</td>
        <td class="r">{{ band.original_cost | intl }}</td>
        <td class="r">{{ band.expenditure | intl }}</td>
        <td class="r">-</td>
      </tr>
      {% endfor %}
      <tr class="total">
        <td class="r" colspan="5">Grand Total</td>
        <td class="r">{{ ns.orig | intl }}</td>
        <td class="r">{{ ns.exp | intl }}</td>
        <td class="r">-</td>
      </tr>
    </tbody>
  </table>
  <div class="note-line">Revised DoC shown under Original/Target DoC where updated by the project authority.</div>
  {{ asterisk() }}
</div>